        self.scheduler = self.create_scheduler()
        
        # Elemental training schedule
        self.elemental_schedule = self.create_elemental_schedule()
        
        # Trinity training schedule
        self.trinity_schedule = self.create_trinity_schedule()
        
        # Quantum training (if available)
        self.quantum_training = config.quantum_training if hasattr(config, 'quantum_training') else False
        
    def create_optimizer(self):
        """Create optimizer with elemental-aware parameters"""
        
        # Group parameters by elemental characteristics
        earth_params = []  # Stable, foundational parameters
        water_params = []  # Flowing, adaptive parameters
        fire_params = []   # Transformative parameters
        air_params = []    # Communicative parameters
        ether_params = []  # Quantum parameters
        
        for name, param in self.model.named_parameters():
            if 'quantum' in name or 'ether' in name:
                ether_params.append(param)
            elif 'attention' in name or 'air' in name:
                air_params.append(param)
            elif 'mlp' in name or 'fire' in name:
                fire_params.append(param)
            elif 'embed' in name or 'norm' in name or 'earth' in name:
                earth_params.append(param)
            else:
                water_params.append(param)
        
        # Create parameter groups with different learning rates
        param_groups = [
            {'params': earth_params, 'lr': self.learning_rate * 0.8, 'weight_decay': 0.01},
            {'params': water_params, 'lr': self.learning_rate * 1.0, 'weight_decay': 0.005},
            {'params': fire_params, 'lr': self.learning_rate * 1.2, 'weight_decay': 0.001},
            {'params': air_params, 'lr': self.learning_rate * 1.1, 'weight_decay': 0.002},
            {'params': ether_params, 'lr': self.learning_rate * 0.9, 'weight_decay': 0.0},
        ]
        
        optimizer = torch.optim.AdamW(param_groups, eps=1e-8)
        
        return optimizer
    
    def create_scheduler(self):
        """Create learning rate scheduler with warmup"""
        scheduler = get_linear_schedule_with_warmup(
            self.optimizer,
            num_warmup_steps=self.warmup_steps,
            num_training_steps=self.config.max_steps
        )
        return scheduler
    
    def create_elemental_schedule(self):
        """Create schedule for elemental weight adjustments during training"""
        
        schedule = {
            'phase_1': {  # Foundation (early training)
                'earth': 0.35, 'water': 0.20, 'fire': 0.20, 'air': 0.15, 'ether': 0.10
            },
            'phase_2': {  # Learning (mid training)
                'earth': 0.25, 'water': 0.25, 'fire': 0.25, 'air': 0.15, 'ether': 0.10
            },
            'phase_3': {  # Optimization (late training)
                'earth': 0.20, 'water': 0.20, 'fire': 0.30, 'air': 0.20, 'ether': 0.10
            },
            'phase_4': {  # Refinement (final training)
                'earth': 0.25, 'water': 0.20, 'fire': 0.25, 'air': 0.15, 'ether': 0.15
            }
        }
        
        return schedule
    
    def create_trinity_schedule(self):
        """Create schedule for Trinity mode adjustments"""
        
        schedule = {
            'phase_1': 'analytical',  # Focus on factual learning
            'phase_2': 'emotional',   # Develop understanding
            'phase_3': 'creative',    # Encourage innovation
            'phase_4': 'balanced',    # Balanced intelligence
        }
        
        return schedule
    
    def train_step(self, batch, step):
        """Perform a single training step"""
        
        # Determine training phase
        phase = self.get_training_phase(step)
        
        # Get elemental balance for this phase
        elemental_balance = self.elemental_schedule[phase]
        
        # Get Trinity mode for this phase
        trinity_mode = self.trinity_schedule[phase]
        
        # Prepare batch
        input_ids = batch['input_ids'].to(self.model.device)
        labels = batch['labels'].to(self.model.device) if 'labels' in batch else input_ids
        
        # Forward pass
        outputs = self.model(
            input_ids=input_ids,
            labels=labels,
            elemental_balance=elemental_balance,
            trinity_mode=trinity_mode,
            use_quantum=self.quantum_training
        )
        
        loss = outputs['loss'] if 'loss' in outputs else None
        
        # If loss not computed, compute it
        if loss is None:
            logits = outputs['logits']
            shift_logits = logits[..., :-1, :].contiguous()
            shift_labels = labels[..., 1:].contiguous()
            loss = F.cross_entropy(
                shift_logits.view(-1, shift_logits.size(-1)),
                shift_labels.view(-1)
            )
        
        # Backward pass
        loss.backward()
        
        # Gradient clipping
        torch.nn.utils.clip_grad_norm_(self.model.parameters(), self.max_grad_norm)
        
        # Optimizer step
        self.optimizer.step()
        self.scheduler.step()
        self.optimizer.zero_grad()
        
        # Log metrics
        metrics = {
            'loss': loss.item(),
            'learning_rate': self.scheduler.get_last_lr()[0],
            'phase': phase,
            'elemental_balance': elemental_balance,
            'trinity_mode': trinity_mode
        }
        
        return metrics
    
    def get_training_phase(self, step):
        """Determine current training phase"""
        total_steps = self.config.max_steps
        
        if step < total_steps * 0.25:
            return 'phase_1'
        elif step < total_steps * 0.50:
            return 'phase_2'
        elif step < total_steps * 0.75:
            return 'phase_3'
        else:
            return 'phase_4'
    
    def train(self, num_steps):
        """Main training loop"""
        
        self.model.train()
        
        for step in range(num_steps):
            # Get batch
            batch = self.get_training_batch()
            
            # Training step
            metrics = self.train_step(batch, step)
            
            # Logging
            if step % self.config.logging_steps == 0:
                self.log_metrics(metrics, step)
            
            # Evaluation
            if step % self.config.eval_steps == 0 and self.eval_dataset:
                eval_metrics = self.evaluate()
                self.log_metrics(eval_metrics, step, prefix='eval')
            
            # Checkpointing
            if step % self.config.save_steps == 0:
                self.save_checkpoint(step)
    
    def evaluate(self):
        """Evaluate model"""
        self.model.eval()
        
        eval_metrics = {}
        total_loss = 0
        num_batches = 0
        
        with torch.no_grad():
            for batch in self.eval_dataloader:
                # Prepare batch
                input_ids = batch['input_ids'].to(self.model.device)
                labels = batch['labels'].to(self.model.device) if 'labels' in batch else input_ids
                
                # Forward pass with balanced settings
                outputs = self.model(
                    input_ids=input_ids,
                    labels=labels,
                    elemental_balance=self.config.elemental_weights,
                    trinity_mode='balanced'
                )
                
                loss = outputs['loss'] if 'loss' in outputs else None
                
                if loss is None:
                    logits = outputs['logits']
                    shift_logits = logits[..., :-1, :].contiguous()
                    shift_labels = labels[..., 1:].contiguous()
                    loss = F.cross_entropy(
                        shift_logits.view(-1, shift_logits.size(-1)),
                        shift_labels.view(-1)
                    )
                
                total_loss += loss.item()
                num_batches += 1
        
        eval_metrics['loss'] = total_loss / num_batches
        
        self.model.train()
        
        return eval_metrics
