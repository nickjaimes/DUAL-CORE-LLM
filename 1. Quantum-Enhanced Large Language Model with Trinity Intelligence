class PerformanceMonitor(nn.Module):
    """Monitor model performance metrics"""
    
    def __init__(self, hidden_size):
        super().__init__()
        self.metric_extractors = nn.ModuleDict({
            'gradient_norm': nn.Linear(hidden_size, 1),
            'activation_variance': nn.Linear(hidden_size, 1),
            'attention_entropy': nn.Linear(hidden_size, 1),
            'information_flow': nn.Linear(hidden_size, 1),
        })
    
    def forward(self, hidden_states):
        metrics = {}
        
        # Gradient norm (approximated)
        metrics['gradient_norm'] = torch.norm(hidden_states, dim=-1).mean()
        
        # Activation variance
        metrics['activation_variance'] = hidden_states.var(dim=-1).mean()
        
        # Attention entropy (if attention scores are available)
        if hasattr(self, 'attention_scores'):
            attention_probs = F.softmax(self.attention_scores, dim=-1)
            attention_entropy = -torch.sum(
                attention_probs * torch.log(attention_probs + 1e-10), dim=-1
            ).mean()
            metrics['attention_entropy'] = attention_entropy
        
        # Information flow
        metrics['information_flow'] = self.compute_information_flow(hidden_states)
        
        return metrics
    
    def compute_information_flow(self, hidden_states):
        """Compute information flow between layers"""
        batch_size, seq_len, hidden_size = hidden_states.shape
        
        # Reshape for processing
        reshaped = hidden_states.view(batch_size * seq_len, hidden_size)
        
        # Compute mutual information approximation
        covariance = torch.cov(reshaped.T)
        eigenvalues = torch.linalg.eigvalsh(covariance)
        eigenvalues = eigenvalues[eigenvalues > 1e-10]
        
        # Compute entropy from eigenvalues
        entropy = 0.5 * torch.sum(torch.log(2 * math.pi * math.e * eigenvalues))
        
        return entropy / hidden_size
