            batch_size, seq_len, hidden_size = x.shape
            
            # Analytical path
            analytical = x * self.analytical_weight
            
            # Emotional path (with different processing)
            emotional = F.gelu(x) * self.emotional_weight
            
            # Creative path
            creative = torch.sin(x) * self.creative_weight  # Sinusoidal for creativity
            
            # Combine and fuse
            combined = torch.cat([analytical, emotional, creative], dim=-1)
            fused = self.fusion_network(combined)
            
            return fused
        
