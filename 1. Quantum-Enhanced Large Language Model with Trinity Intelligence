        self.logic_enhancer = nn.Linear(hidden_dim, hidden_dim)
        self.reasoning_network = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim * 2),
            nn.ReLU(),
            nn.Linear(hidden_dim * 2, hidden_dim),
